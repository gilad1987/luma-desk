{
  "name": "luma-desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/install-git-hooks.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . && npm run check:lines && npm run check:no-js && npm run format:check",
    "lint:fix": "eslint . --fix && prettier --write .",
    "check:lines": "node scripts/check-lines.ts",
    "check:no-js": "node scripts/check-no-js.ts",
    "fetch:mvr-xsd": "node scripts/fetch-mvr-xsd.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @screenshot",
    "test:screenshots": "playwright test --grep @screenshot",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.160.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.5.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "xmllint-wasm": "5.3.0"
  }
}
